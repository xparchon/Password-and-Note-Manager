<Window x:Class="Password_and_Note_Manager.Views.EditCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar Credencial" Height="440" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="✏️ Editar Credencial" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Campos do Formulário -->
        <!-- Formulário Envolvido num ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,5,0">
                <TextBlock Text="Title" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtTitle" Height="30" VerticalContentAlignment="Center" Background="#F1F5F9" BorderBrush="#CBD5E1" Padding="5,0" Margin="0,0,0,10"/>

                <TextBlock Text="Website URL" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtWebsite" Height="30" VerticalContentAlignment="Center" Background="#F1F5F9" BorderBrush="#CBD5E1" Padding="5,0" Margin="0,0,0,10"/>

                <TextBlock Text="Username / Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtUsername" Height="30" VerticalContentAlignment="Center" Background="#F1F5F9" BorderBrush="#CBD5E1" Padding="5,0" Margin="0,0,0,10"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtPassword" Height="30" VerticalContentAlignment="Center" Background="#F1F5F9" BorderBrush="#CBD5E1" Padding="5,0" Margin="0,0,0,10"/>

                <TextBlock Text="Notes" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtNotes" Height="60" Background="#F1F5F9" BorderBrush="#CBD5E1" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="5" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botão Salvar -->
        <Button x:Name="BtnSave" Grid.Row="2" Content="Salvar Alterações" Height="35" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0" Click="BtnSave_Click"/>
    </Grid>
</Window>