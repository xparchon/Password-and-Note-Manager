<Window x:Class="Password_and_Note_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Password_and_Note_Manager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Painel Esquerdo (Lista de Contas) -->
            <ColumnDefinition Width="280"/>
            <!-- Painel Direito (Detalhes da Senha Selecionada) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PAINEL ESQUERDO -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título, Botão de Trocar Cofre e Busca -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔐 My Vault" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🚪 Logout" Background="#FEE2E2" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand" Click="BtnLogout_Click"/>
                    </Grid>
                    <TextBox x:Name="txtSearch" Height="30" VerticalContentAlignment="Center" Background="#F1F5F9" BorderBrush="#CBD5E1" Padding="5,0" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <!-- Lista de Credenciais -->
                <ListBox x:Name="lstCredentials" Grid.Row="1" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title" SelectionChanged="LstCredentials_SelectionChanged"/>

                <!-- Botão de Inserir Nova -->
                <Button x:Name="btnNewCredential" Grid.Row="2" Content="+ Add New Password" Height="35" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnNewCredential_Click"/>
            </Grid>
        </Border>

        <!-- PAINEL DIREITO -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho do Detalhe -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="lblSelectedTitle" Text="Select an item from the list" FontSize="20" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock x:Name="lblSelectedUrl" Text="" FontSize="14" Foreground="#2563EB" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Painel de Detalhes e Botões (Oculto por defeito até selecionar um item) -->
            <StackPanel x:Name="pnlDetails" Grid.Row="1" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock Text="Username / Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDisplayUsername" Height="35" IsReadOnly="True" Background="#F1F5F9" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,15"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtDisplayPassword" Grid.Column="0" Height="35" IsReadOnly="True" Background="#F1F5F9" BorderBrush="#CBD5E1" VerticalContentAlignment="Center" Padding="8,0"/>
                    <Button x:Name="btnShowPassword" Grid.Column="1" Content="Reveal" Height="35" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0" Click="BtnShowPassword_Click"/>
                </Grid>

                <TextBlock Text="Notes" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDisplayNotes" Height="70" IsReadOnly="True" Background="#F1F5F9" BorderBrush="#CBD5E1" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8" AcceptsReturn="True" Margin="0,0,0,15"/>

                <!-- Botões de Editar e Excluir -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEditCredential" Content="Edit" Width="90" Height="30" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnEditCredential_Click"/>
                    <Button x:Name="BtnDeleteCredential" Content="Delete" Width="90" Height="30" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Cursor="Hand" Click="BtnDeleteCredential_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>